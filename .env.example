# App Settings
APP_NAME="Semantic EPUB Pipeline"

# Database
# Default is local SQLite. The pipeline is fully Postgres-ready for future scale.
DATABASE_URL="sqlite:///d:/agentic_workflow/data/pipeline.db"

# LLM Config (Modular API Configuration)
# Choose one of the configurations below:

# OPTION A: OpenAI Configuration
# LLM_API_KEY="sk-..."
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o"

# OPTION B: Google Gemini API Configuration (OpenAI Compatible)
# LLM_API_KEY="AIzaSy..."
# LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# LLM_MODEL="gemini-2.5-flash"  # or gemini-2.5-pro

# OPTION C: Anthropic / Local LLM / Stub (Fallback)
# If left empty, the pipeline runs gracefully in deterministic fallback mode.
LLM_API_KEY="your-api-key-here"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o"
